{
  "name": "arcade-telemetry-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Local 'Arcade Telemetry' observability dashboard + MCP connector used for the GitHub Copilot App Universe demo",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "reset": "node scripts/reset.js",
    "generate-data": "node scripts/generate-data.js",
    "mcp": "node mcp-server/server.js",
    "test:mcp": "node scripts/list-mcp-tools.js",
