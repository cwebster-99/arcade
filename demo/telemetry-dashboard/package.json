    "verify": "node scripts/e2e.js",
    "mcp:config": "node scripts/print-mcp-config.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  }
}
