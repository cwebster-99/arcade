# Copy to .env and fill in. All values are optional — when unset, Sentry and
# telemetry are disabled (no-op) so local dev and tests are unaffected.

# Sentry DSN from https://sentry.io → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=
# Sentry environment tag (defaults to the Vite mode, e.g. "development")
VITE_SENTRY_ENVIRONMENT=production
# Release version reported to Sentry/telemetry (defaults to package.json version)
VITE_APP_VERSION=1.4.0
# Optional HTTP endpoint that receives TTFF events as JSON POSTs
VITE_TELEMETRY_URL=

# Used by scripts/seed-sentry-crash.mjs (falls back to VITE_SENTRY_DSN)
SENTRY_DSN=
# Optional: your Sentry org slug, used to print a direct issue link
SENTRY_ORG=
